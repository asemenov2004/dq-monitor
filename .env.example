# Скопировать в .env и при необходимости поменять значения.
# Порт 5433: на 5432 часто уже работает локальный PostgreSQL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=dq
POSTGRES_PASSWORD=dq_local_password

# Хранилище данных (полигон TPC-H)
WAREHOUSE_DB=warehouse
# Метаданные dq-monitor: правила, запуски, инциденты
META_DB=meta

# Предельное время одного запроса проверки, секунд
CHECK_STATEMENT_TIMEOUT_SEC=60

# Полигон TPC-H (пакет dq_stand)
# Масштаб данных: 1 ~ 1 ГБ, 0.01 ~ 10 МБ
STAND_SCALE_FACTOR=1
# С какой даты начинаются данные (исходные даты TPC-H сдвигаются)
STAND_START_DATE=2025-01-01

# Локальный Airflow (Compose подставляет значения по умолчанию, если их нет в .env).
AIRFLOW_PORT=8081
AIRFLOW_ADMIN_PASSWORD=airflow_local_password
AIRFLOW_DB_PASSWORD=airflow_db_local_password

# Web: один локальный пользователь, без публикации в сеть.
WEB_PORT=8000

# Локальные уведомления. scripts/mvp.py up создаст секреты Mattermost в .env.
MATTERMOST_PORT=8065
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1026
NOTIFY_ENABLED=false
NOTIFY_CHANNELS=email,mattermost
NOTIFY_SMTP_HOST=localhost
NOTIFY_SMTP_PORT=1026
NOTIFY_SMTP_FROM=dq-monitor@example.test
NOTIFY_SMTP_TO=demo@example.test
NOTIFY_SMTP_STARTTLS=false
NOTIFY_SMTP_SSL=false
# Для настоящего SMTP задать host, port, TLS, username/password и адресатов.
# NOTIFY_SMTP_USERNAME=
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_MATTERMOST_WEBHOOK_URL= создаётся локальным bootstrap.
NOTIFY_TIMEOUT_SEC=10
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BASE_SEC=30
NOTIFY_RETRY_MAX_SEC=3600
NOTIFY_POLL_INTERVAL_SEC=5
